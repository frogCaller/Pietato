#!/usr/bin/env python3
"""A pretend rpicam-still: a JPEG as big as --width x --height (the sensor's own size without them) into -o."""
import os, sys
a = sys.argv[1:]


def opt(name, default=None):
    return a[a.index(name) + 1] if name in a else default


log = os.environ.get("FAKE_RPICAM_LOG")
if log:
    with open(log, "a") as f:
        f.write("rpicam-still " + " ".join(a) + "\n")
if os.environ.get("FAKE_PICAM_BUSY"):
    sys.stderr.write("ERROR: *** failed to acquire camera /base/axi/pcie@120000/rp1/i2c@88000/imx708@1a ***\n")
    sys.exit(1)
from PIL import Image
Image.new("RGB", (int(opt("--width", "4608")), int(opt("--height", "2592"))), (200, 180, 90)).save(opt("-o"), "JPEG")
